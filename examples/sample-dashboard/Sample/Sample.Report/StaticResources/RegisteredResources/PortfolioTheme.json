{
  "name": "PortfolioTheme",
  "dataColors": [
    "#64748B",
    "#2563EB",
    "#0F766E",
    "#7C3AED",
    "#B45309",
    "#4D7C0F"
  ],
  "good": "#16A34A",
  "neutral": "#D97706",
  "bad": "#DC2626",
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2563EB",
  "textClasses": {
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#1F2937"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4B5563"
    },
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Light",
      "color": "#1F2937"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#F3F4F6"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "categoryAxis": [
          {
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#F3F4F6"
              }
            }
          }
        ]
      }
    }
  }
}