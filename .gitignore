# Source material — never commit private reference documents
Books/

# Generated PMO artifacts may contain confidential product/roadmap data.
# This template tracks the folder READMEs (the structure) but ignores generated
# content. Uncomment to keep your own artifacts in git, or commit selectively.
# knowledge/prds/*
# knowledge/sprints/*
# knowledge/projects/*
# knowledge/launches/*
# knowledge/ceremonies/*
# !knowledge/**/README.md

# Power BI Projects (PBIP): the .pbip / .pbir / .tmdl / .json text IS tracked —
# it's the reproducible layer, same as .md. Only the binary cache and per-user
# state are ignored (these match what Power BI Desktop generates when you save
# as a project). A BOM in localSettings.json stops Desktop opening the whole
# project, and being gitignored does not mean Desktop skips it.
*.pbix
*.pbit
**/.pbi/cache.abf
**/.pbi/localSettings.json

# Secrets / environment files
.env
.env.*
*.env
secrets.*
*.key
*.pem

# Python (if any local tooling is added)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node (if any local tooling is added)
node_modules/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
