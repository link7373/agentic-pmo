.env
.env.*
*.env
secrets.*
*.key
*.pem

# Python (if any local tooling is added)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node (if any local tooling is added)
node_modules/

# Editor / OS
.DS_Store
Thumbs.db
